# Claude Code 個人設定（per-user，勿 commit）
.claude/

# macOS
.DS_Store

# Cloudflare Pages build output（由 scripts/deploy-cf-pages.sh 產生）
dist/

# Wrangler 本機狀態
.wrangler/

# Playwright MCP 截圖與報告（本機驗證用）
.playwright-mcp/

# Release 燒錄用 merged firmware（由 scripts/post_build_merge.py 產生）
firmware/firmware-merged.bin
firmware/firmware-merged-*.bin

# 打包流程的產物：CLAUDE.md「打包流程速查」會把 merged bin 複製進 release-template/
# 再 zip 起來，兩者都是 build 產物不進版控（漏擋會讓每次打包留下 1.4MB binary）
firmware/release-template/firmware-merged.bin
firmware/ems-timer-firmware-*.zip

# superpowers SDD 工作區（ledger / brief / review package 等 scratch，不進版控）
.superpowers/

# superpowers 隔離開發用 git worktree（scratch，不進版控）
.worktrees/
